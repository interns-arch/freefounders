# FreeFounders Platform API. Copy to .env (never commit .env).

# Postgres. Blank = the bundled local database on port 5434 (npm run dev).
DATABASE_URL=
# PGSSLMODE=require

PORT=4000
NODE_ENV=production
# Set true when running behind the gateway/proxy so client IPs and https are read from X-Forwarded-*.
TRUST_PROXY=true
# Failed sign-ins allowed from one IP address per 15 minutes before it must wait (default 50; 0 = off). Needs
# TRUST_PROXY=true behind the gateway, or every visitor looks like the gateway's address.
# LOGIN_IP_LIMIT=50
# Refresh cookie is Secure in production; set false only for plain-http LAN testing.
COOKIE_SECURE=true

# REQUIRED in production, 32+ random characters. Encrypts the token-signing keys stored in the database.
# Changing it makes existing signing keys unreadable (everyone signs in again). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PLATFORM_SECRET=

# Each app's internal API, used when an admin gives a person access to that app.
TASKS_INTERNAL_URL=http://localhost:8000/api/internal
ASSETS_INTERNAL_URL=http://localhost:3000/api/internal

# First start of a real install: `node dist/seed.js --bootstrap` creates the company and its owner.
COMPANY_NAME=
COMPANY_CODE=
COMPANY_APPS=tasks,assets
OWNER_NAME=
OWNER_EMAIL=
OWNER_LOGIN=
OWNER_PASSWORD=

# ─── Sign-up, accounts and billing (PLAN.md §21) ───────────────────────────
# Address of the web app, used in invite links (/join/<token>). Blank = the request's origin.
PUBLIC_WEB_URL=
# One-time codes per IP address per 15 minutes (default 20; 0 = off).
# OTP_IP_LIMIT=20
# DEV ONLY (scripts/dev.mjs sets them; never in production, they are ignored when NODE_ENV=production):
#   OTP_DEV_ECHO=1         the one-time code is returned in the answer (and always written to the Platform log)
#   BILLING_DEV_TOOLS=1    Billing page: advance the billing clock, simulate renewals
# Fake payment gateway ("FakePay · test mode"): HMAC secret of its webhooks (16+ characters). Unset = no fake payments.
FAKE_GATEWAY_SECRET=
# How often the billing clock runs (renewals, trial end, past due → read-only → suspended). 0 = off.
# BILLING_TICK_SECONDS=300
# Who sells, on GST invoices (defaults are clearly fake test values).
SELLER_NAME=
SELLER_GSTIN=
SELLER_STATE=Maharashtra
SELLER_ADDRESS=
# Dev seed (node dist/seed.js, never in production) also creates a FreeFounders staff account for the owner console:
#   staff@freefounders.test / Demo@1234 (public test values, like the demo owner). On a real install: sign up, then
#   npm run company -- staff --email <their email>

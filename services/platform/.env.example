# Kaampilot Platform API. Copy to .env (never commit .env).

# Postgres. Blank = the bundled local database on port 5434 (npm run dev).
DATABASE_URL=
# PGSSLMODE=require

PORT=4000
NODE_ENV=production
# Set true when running behind the gateway/proxy so client IPs and https are read from X-Forwarded-*.
TRUST_PROXY=true
# Bot guard: failed sign-ins allowed from one IP address per 15 minutes before it must wait (default 1000; 0 = off).
# Needs TRUST_PROXY=true behind the gateway, or every visitor looks like the gateway's address.
# LOGIN_IP_LIMIT=1000
# Wrong passwords before a login/account is locked for 15 minutes. Default 0 = never lock (founder decision 2026-10-19:
# anyone can try any number of times). A positive number (e.g. 5) turns the old lockout back on.
# LOGIN_MAX_FAILED=0
# Refresh cookie is Secure in production; set false only for plain-http LAN testing.
COOKIE_SECURE=true

# REQUIRED in production, 32+ random characters. Encrypts the token-signing keys stored in the database.
# Changing it makes existing signing keys unreadable (everyone signs in again). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PLATFORM_SECRET=

# Each app's internal API, used when an admin gives a person access to that app.
TASKS_INTERNAL_URL=http://localhost:8000/api/internal
ASSETS_INTERNAL_URL=http://localhost:3000/api/internal

# First start of a real install: `node dist/seed.js --bootstrap` creates the company and its owner.
COMPANY_NAME=
COMPANY_CODE=
COMPANY_APPS=tasks,assets
OWNER_NAME=
OWNER_EMAIL=
OWNER_LOGIN=
OWNER_PASSWORD=

# ─── Sign-up, accounts and billing (PLAN.md §21) ───────────────────────────
# Address of the web app, used in invite links (/join/<token>). Blank = the request's origin.
PUBLIC_WEB_URL=
# One-time codes per IP address per 15 minutes (default 20; 0 = off).
# OTP_IP_LIMIT=20
# Who sends one-time codes (PLAN.md §21.8): fake (default: written to the Platform log, nothing leaves the machine) or
# msg91. With msg91 and MSG91_AUTHKEY / MSG91_SMS_TEMPLATE_ID missing, asking for a code answers 503 and the reason is
# in the log (never a key). Email codes go through MSG91 only when the email template and From address are set;
# otherwise they stay on the fake sender in dev / DEMO_MODE=1 and answer 503 in production.
# Never commit real values; on the server they live only in /opt/freefounders/.env (infra/deploy/set-msg91.sh).
# OTP_SENDER=fake
MSG91_AUTHKEY=
# MSG91 → OTP → template ID (DLT-approved text with ##OTP##, e.g. "Your Kaampilot code is ##OTP##. It is valid for 10 minutes. Do not share it with anyone.")
MSG91_SMS_TEMPLATE_ID=
# MSG91 → Email → template ID (uses {{otp}}, {{minutes}}, {{app}}, {{purpose}}) and a From address on a verified domain.
MSG91_EMAIL_TEMPLATE_ID=
MSG91_EMAIL_FROM=
# Optional: sender name (default Kaampilot) and the verified sending domain (default: the From address's domain).
# MSG91_EMAIL_FROM_NAME=Kaampilot
# MSG91_EMAIL_DOMAIN=
# DEV ONLY (scripts/dev.mjs sets them; never in production, they are ignored when NODE_ENV=production):
#   OTP_DEV_ECHO=1         the one-time code is returned in the answer (and always written to the Platform log)
#   BILLING_DEV_TOOLS=1    Billing page: advance the billing clock, simulate renewals
# Fake payment gateway ("FakePay · test mode"): HMAC secret of its webhooks (16+ characters). Unset = no fake payments.
FAKE_GATEWAY_SECRET=
# Payment gateway for new checkouts (PLAN.md §21.10): fake | cashfree (BILLING_GATEWAY is the older name, read only
# when PAYMENT_GATEWAY is empty). Default fake in dev and on the open demo (DEMO_MODE=1). A production build without
# DEMO_MODE needs cashfree + the two keys below, otherwise checkout answers 503 "Payments are not set up yet" (the rest
# of the app keeps working; the reason is in the Platform log, never a key). "razorpay" (removed 2026-10-24) = off.
# PAYMENT_GATEWAY=cashfree
# Cashfree Merchant Dashboard → Payment Gateway → Developers → API Keys: App ID and Secret Key (sandbox keys first).
# Never commit real values; on the server they live only in /opt/freefounders/.env (infra/deploy/set-cashfree.sh).
# Webhooks are signed with the same Secret Key: add https://<domain>/api/platform/billing/webhooks/cashfree there.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# production | sandbox (default sandbox). CASHFREE_API_VERSION: x-api-version, default 2026-01-01.
CASHFREE_ENV=sandbox
# CASHFREE_API_VERSION=2026-01-01
# How often the billing clock runs (renewals, trial end, past due → read-only → suspended). 0 = off.
# BILLING_TICK_SECONDS=300
# Who sells, on GST invoices (defaults are clearly fake test values).
SELLER_NAME=
SELLER_GSTIN=
SELLER_STATE=Maharashtra
SELLER_ADDRESS=
# Dev seed (node dist/seed.js, never in production) also creates a Kaampilot staff account for the owner console:
#   staff@kaampilot.test / Demo@1234 (public test values, like the demo owner). On a real install: sign up, then
#   npm run company -- staff --email <their email>
# Phone app update banner (PLAN.md §19.30, §19.40): an installed app older than this shows "A new version of Kaampilot
# is available" with the download link (non-blocking). Off unless set (e.g. 1.2.2 once that APK is on the site). The APK
# address: a path on this server (default /download/kaampilot.apk, i.e. the file apps/web/public/download/kaampilot.apk,
# live https://kaampilot.com/download/kaampilot.apk; *.apk is git-ignored) or a full https:// address.
# MOBILE_MIN_VERSION=1.2.2
# MOBILE_APK_URL=/download/kaampilot.apk

# Kaampilot Assets API. Copy to .env (never commit .env). Values for a production install behind the gateway.

# Postgres. Blank = the bundled local database on port 5433 (npm run dev).
DATABASE_URL=
# verify-full checks the database server's certificate (recommended); PGSSLROOTCERT = CA file (e.g. the RDS bundle).
# Without it a remote database is encrypted but its certificate is not checked.
# PGSSLMODE=verify-full
# PGSSLROOTCERT=/etc/ssl/rds-global-bundle.pem
DB_POOL_SIZE=20

PORT=3000
# production: session cookies are Secure (https only). COOKIE_SECURE=false only for plain-http LAN testing.
NODE_ENV=production
COOKIE_SECURE=true
# Behind the gateway/proxy: read the client address and https from X-Forwarded-* (else only from loopback).
TRUST_PROXY=true

# The public address printed into QR codes (the gateway's https address).
PUBLIC_URL=https://app.example.com

# Kaampilot single login: the Platform's public keys (no secret). Off when blank (standalone Assets).
PLATFORM_JWKS_URL=http://platform:4000/api/platform/.well-known/jwks.json
# One Postgres schema per company (PLAN.md §14). People then sign in through the Platform only.
TENANCY=schemas

# Photos decoded at the same time on this server (memory guard); older photos on disk are read from UPLOAD_DIR.
PHOTO_CONCURRENCY=2
# UPLOAD_DIR=/data/uploads

# Standalone first start only (not used with TENANCY=schemas): the first admin. Blank password = a one-time one is printed.
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_LOGIN=
# ADMIN_PASSWORD=
# COMPANY_NAME=

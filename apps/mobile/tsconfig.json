{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@freefounders/core": [
        "../../packages/core/src/index.ts"
      ],
      "@freefounders/core/*": [
        "../../packages/core/src/*/index.ts"
      ],
      "@freefounders/theme/native": [
        "../../packages/theme/src/tokens.native.ts"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "@tanstack/react-query": [
        "./node_modules/@tanstack/react-query"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test"
  ]
}

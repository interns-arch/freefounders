{
  "expo": {
    "name": "Kaampilot",
    "slug": "kaampilot",
    "version": "1.2.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "freefounders",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f6f7fb",
    "ios": {
      "bundleIdentifier": "com.freefounders.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Kaampilot takes a selfie when you punch in or out, and lets you take photos for attachments.",
        "NSLocationWhenInUseUsageDescription": "Kaampilot checks that you are at your office when you punch in or out.",
        "NSMicrophoneUsageDescription": "Kaampilot listens when you speak a task (Voice draft).",
        "NSSpeechRecognitionUsageDescription": "Kaampilot turns the task you speak into text (Voice draft)."
      }
    },
    "android": {
      "package": "com.freefounders.app",
      "adaptiveIcon": {
        "backgroundColor": "#4f46e5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "versionCode": 5
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Kaampilot takes a selfie when you punch in or out, because your company keeps a photo of every punch.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kaampilot checks that you are at your office when you punch in or out."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f6f7fb",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#09090b"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Kaampilot listens when you speak a task (Voice draft).",
          "speechRecognitionPermission": "Kaampilot turns the task you speak into text (Voice draft).",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#4f46e5"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "useLegacyPackaging": true
          }
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": false
    },
    "extra": {
      "webUrl": "https://kaampilot.com",
      "router": {},
      "eas": {
        "projectId": "60e32c42-a4a8-4828-9d06-19dea131faef"
      }
    },
    "owner": "interncartrends-team"
  }
}

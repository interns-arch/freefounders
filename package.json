{
  "name": "kaampilot",
  "private": true,
  "description": "Kaampilot: one login for Tasks and Assets (web app + Android app)",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "npm --prefix e2e test",
    "import-company": "node scripts/import-company.mjs",
    "rehearse-import": "node scripts/rehearse-import.mjs",
    "web:build": "npm --workspace @kaampilot/web run build",
    "web:typecheck": "npm --workspace @kaampilot/web run typecheck",
    "mobile": "npm --prefix apps/mobile start",
    "mobile:check": "npm --prefix apps/mobile run typecheck && npm --prefix apps/mobile test",
    "quick-check": "node scripts/quick-check.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ]
}

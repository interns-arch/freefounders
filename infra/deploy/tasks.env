# Non-secret settings of the Tasks API and worker (secrets come from FF_HOME/.env through docker-compose.yml).
DEBUG=false
DB_SSLMODE=disable
DB_CONN_MAX_AGE=60
TENANCY=schemas
PLATFORM_JWKS_URL=http://platform:4000/api/platform/.well-known/jwks.json
# The reminder ticker runs only in tasks-worker (run_worker), never inside gunicorn.
NOTIF_SCHEDULER=false
# One proxy (the gateway) in front: client addresses for rate limits come from X-Forwarded-For.
NUM_PROXIES=1
# No keys on this server: WhatsApp, Gmail and AI stay off.
AI_ENABLED=false
WHATSAPP_ENABLED=false
GMAIL_ENABLED=false
PYTHONUNBUFFERED=1

# Kaampilot gateway for the open demo on the shared server: plain http on :7395 (no certificate yet), the same
# path routing as infra/gateway/dev-gateway.mjs and the prod draft infra/gateway/Caddyfile:
#   /api/platform/*  Platform (path kept)      /tasks/api/*  Tasks (/tasks stripped)      /media/*  Tasks
#   /assets/api/*    Assets (/assets stripped) everything else: the web app (apps/web/dist, mounted at /srv/web)
{
	admin off
	auto_https off
}

(security_headers) {
	header {
		# No HSTS: this site is plain http until it gets a domain and a certificate.
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Cashfree checkout (PLAN.md §21.10, only on /billing/pay/…): its script (sdk.cashfree.com), its API and pages
		# (api / sandbox / payments.cashfree.com: *.cashfree.com), its form posts, Payment Request for it, and popups it
		# may open for bank pages (COOP same-origin-allow-popups keeps their way back).
		Permissions-Policy `camera=(self), geolocation=(self), microphone=(self), payment=(self "https://sdk.cashfree.com" "https://api.cashfree.com" "https://sandbox.cashfree.com"), usb=(), serial=(), bluetooth=(), interest-cohort=()`
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		-Server
		-X-Powered-By
		?Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://sdk.cashfree.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.cashfree.com; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; frame-src 'self' https://*.cashfree.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://*.cashfree.com"
	}
}

http://:7395 {
	encode gzip
	import security_headers

	request_body {
		max_size 100MB
	}

	handle /api/platform/* {
		reverse_proxy platform:4000
	}

	handle_path /tasks/api/* {
		rewrite * /api{uri}
		reverse_proxy tasks:8000
	}
	handle /media/* {
		header ?Cache-Control "private, no-store"
		reverse_proxy tasks:8000
	}

	handle_path /assets/api/* {
		rewrite * /api{uri}
		reverse_proxy assets:3000
	}

	handle {
		root * /srv/web
		@hashed path /static/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		header /index.html Cache-Control "no-cache"
		header /sw.js Cache-Control "no-cache"
		file_server
	}
}
